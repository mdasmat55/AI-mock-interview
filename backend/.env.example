PORT=5000

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>

# Long random secret used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# "mock" -> no Gemini calls, deterministic mock questions/evaluations/report
# "live" (or unset) -> real Gemini API calls
GEMINI_MODE=live

# Comma-separated list of allowed frontend origins for CORS, e.g.
# CORS_ORIGIN=https://myapp.com,https://www.myapp.com
# Leave unset to allow any origin (fine for local dev only).
CORS_ORIGIN=

NODE_ENV=production
